<UserControl x:Class="MicForge.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="AboutLinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="AboutHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,22,0,8"/>
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="Root" MaxWidth="720" HorizontalAlignment="Left">

        <!-- Hero: a small waveform, the name, the version and one line about the app. -->
        <Border Style="{StaticResource Card}" Padding="22,20">
            <StackPanel>
                <StackPanel x:Name="Wave" Orientation="Horizontal" Height="40" HorizontalAlignment="Left"/>
                <TextBlock x:Name="AppNameText" FontSize="26" FontWeight="Bold" Margin="0,12,0,0"/>
                <TextBlock x:Name="TaglineText" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Author card: the standout element. -->
        <Border x:Name="AuthorCard" Margin="0,14,0,0" CornerRadius="12" BorderThickness="1"
                BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}"
                SnapsToDevicePixels="True">
            <Grid>
                <Border CornerRadius="12" Background="{DynamicResource AccentBrush}" Opacity="0.10" IsHitTestVisible="False"/>
                <Border HorizontalAlignment="Left" Width="5" CornerRadius="12,0,0,12"
                        Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
                <Grid Margin="26,20,22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="LK" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource OnStatusBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="AuthorText" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,4,0,14"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <ItemsControl x:Name="LinkButtons">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AboutLinkButton}" Tag="{Binding Url}"
                                            Click="Link_Click" ToolTip="{Binding Url}"
                                            AutomationProperties.Name="{Binding Label}"
                                            AutomationProperties.HelpText="{Binding Url}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <TextBlock x:Name="LinkError" TextWrapping="Wrap" Margin="2,4,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource StopBrush}"/>

        <!-- Facts -->
        <TextBlock Text="THE APP" Style="{StaticResource AboutHeading}"/>
        <ItemsControl x:Name="FactList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Credits and licences -->
        <TextBlock Text="CREDITS AND LICENCES" Style="{StaticResource AboutHeading}"/>
        <ItemsControl x:Name="CreditList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Role}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding License}" Tag="{Binding Url}" Click="Link_Click"
                                    Padding="10,4" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{Binding Url}"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding Url}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
