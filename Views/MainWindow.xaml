<Window x:Class="MicForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MicForge.Controls"
        Title="MicForge" Height="820" Width="1200"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleBypassCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- One template for every stage; the specialised visuals switch on IsEq / IsCompressor + VisualMode. -->
        <DataTemplate x:Key="StageTemplate">
            <Border Width="302" Margin="0,0,12,12" Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Tag="draghandle" Text="⋮⋮" FontSize="16" Cursor="SizeAll"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" ToolTip="Drag to reorder"/>
                            <Border Width="20" Height="18" CornerRadius="5" Margin="0,0,9,0"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <TextBlock Text="{Binding Order}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,9,0"
                                    Background="{Binding Accent, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="InfoBtn" Style="{StaticResource InfoToggle}" Margin="0,0,10,0"
                                          ToolTip="What does this do?"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding Enabled}" IsEnabled="{Binding ToggleEnabled}"
                                      Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Popup PlacementTarget="{Binding ElementName=InfoBtn}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               HorizontalOffset="-250" VerticalOffset="4"
                               IsOpen="{Binding IsChecked, ElementName=InfoBtn}">
                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}"
                                    Padding="14" MaxWidth="300">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Info}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Params}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,0"
                                                            Visibility="{Binding Help, Converter={StaticResource EmptyToCollapsed}}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}"/>

                    <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="{Binding ShowAction, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding HasExtraToggle, Converter={StaticResource BoolToVis}}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExtraToggle}"/>
                        <TextBlock Text="{Binding ExtraToggleText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="200"/>
                    </StackPanel>

                    <!-- Quick EQ-curve presets (EQ card only) -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsEq, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox Width="150" ItemsSource="{Binding EqPresetNames}"
                                  SelectedItem="{Binding SelectedEqPreset}"
                                  ToolTip="Apply an equalizer curve"/>
                    </StackPanel>

                    <!-- EQ graph + spectrum (Graph view) -->
                    <ctrl:EqGraph Height="210" Margin="0,10,0,0" Model="{Binding}">
                        <ctrl:EqGraph.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                <Binding Path="IsEq"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </ctrl:EqGraph.Visibility>
                    </ctrl:EqGraph>

                    <!-- Compressor visuals (Graph view) -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                <Binding Path="IsCompressor"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Transfer curve" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ctrl:CompCurve Height="140" Model="{Binding}"
                                        LevelDb="{Binding DataContext.CompLevelDb, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        <TextBlock Text="Gain reduction" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <ctrl:GrHistory Height="46"
                                        Gr="{Binding DataContext.CompGrDb, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </StackPanel>

                    <!-- Gate visual (Graph view) -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                <Binding Path="IsGate"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Level vs open threshold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ctrl:ThresholdMeter Height="18"
                                             Level="{Binding DataContext.GateLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Threshold="{Binding DataContext.GateThreshold, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Active="{Binding DataContext.GateOpen, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        <TextBlock Text="Gain reduction" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
                        <ctrl:GrHistory Height="40"
                                        Gr="{Binding DataContext.GateGrDb, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </StackPanel>

                    <!-- Limiter visual (Graph view) -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                <Binding Path="IsLimiter"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Gain reduction (peaks caught)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ctrl:GrHistory Height="46"
                                        Gr="{Binding DataContext.LimiterGrDb, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </StackPanel>

                    <!-- De-esser visual (Graph view) -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueVis}">
                                <Binding Path="IsDeEsser"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="Sibilance vs threshold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ctrl:ThresholdMeter Height="18"
                                             Level="{Binding DataContext.DeEsserLevel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Threshold="{Binding DataContext.DeEsserThreshold, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Active="{Binding DataContext.DeEsserActive, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </StackPanel>

                    <!-- sliders (hidden for EQ in Graph view) -->
                    <ItemsControl ItemsSource="{Binding Params}" Margin="0,4,0,0">
                        <ItemsControl.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueCollapsed}">
                                <Binding Path="IsEq"/>
                                <Binding Path="DataContext.VisualMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </ItemsControl.Visibility>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Grid.Row="1" Style="{StaticResource Fader}" Margin="0,3,0,0"
                                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= NAV RAIL ================= -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Width="32" Height="32" CornerRadius="8" Margin="0,16,0,20" HorizontalAlignment="Center"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="M" FontWeight="Bold" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource NavButton}" ToolTip="Processor"
                        Command="{Binding ShowProcessorCommand}" Tag="{Binding IsProcessorPage}">
                    <Viewbox Width="22" Height="22">
                        <Path Stretch="Uniform"
                              Data="M3,17v2h6v-2H3z M3,5v2h10V5H3z M13,21v-2h8v-2h-8v-2h-2v6H13z M7,9v2H3v2h4v2h2V9H7z M21,13v-2H11v2H21z M15,7h2V5h4V3h-4V1h-2V7z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource NavButton}" ToolTip="Crafting"
                        Command="{Binding ShowCraftingCommand}" Tag="{Binding IsCraftingPage}">
                    <Viewbox Width="22" Height="22">
                        <Path Stretch="Uniform"
                              Data="M12,2C6.49,2,2,6.49,2,12s4.49,10,10,10c1.38,0,2.5-1.12,2.5-2.5c0-0.61-0.23-1.2-0.64-1.67 c-0.08-0.1-0.13-0.21-0.13-0.33c0-0.28,0.22-0.5,0.5-0.5H16c3.31,0,6-2.69,6-6C22,6.04,17.51,2,12,2z M6.5,13 C5.67,13,5,12.33,5,11.5S5.67,10,6.5,10S8,10.67,8,11.5S7.33,13,6.5,13z M9.5,9C8.67,9,8,8.33,8,7.5S8.67,6,9.5,6 S11,6.67,11,7.5S10.33,9,9.5,9z M14.5,9C13.67,9,13,8.33,13,7.5S13.67,6,14.5,6S16,6.67,16,7.5S15.33,9,14.5,9z M17.5,13 c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.33,13,17.5,13z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource NavButton}" ToolTip="Meters"
                        Command="{Binding ShowMetersCommand}" Tag="{Binding IsMetersPage}">
                    <Viewbox Width="22" Height="22">
                        <Path Stretch="Uniform"
                              Data="M3,13h2v7H3V13z M7,7h2v13H7V7z M11,10h2v10h-2V10z M15,4h2v16h-2V4z M19,9h2v11h-2V9z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource NavButton}" ToolTip="Shortcuts"
                        Command="{Binding ShowShortcutsCommand}" Tag="{Binding IsShortcutsPage}">
                    <Viewbox Width="22" Height="22">
                        <Path Stretch="Uniform"
                              Data="M20,5H4C2.9,5,2.01,5.9,2.01,7L2,17c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V7C22,5.9,21.1,5,20,5z M11,8h2v2h-2V8z M11,11h2v2h-2V11z M8,8h2v2H8V8z M8,11h2v2H8V11z M7,13H5v-2h2V13z M7,10H5V8h2V10z M16,17H8v-2h8V17z M16,13h-2v-2h2V13z M16,10h-2V8h2V10z M19,13h-2v-2h2V13z M19,10h-2V8h2V10z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource NavButton}" ToolTip="Settings"
                        Command="{Binding ShowSettingsCommand}" Tag="{Binding IsSettingsPage}">
                    <Viewbox Width="22" Height="22">
                        <Path Stretch="Uniform"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!-- ================= PROCESSOR PAGE ================= -->
        <Grid Grid.Column="1" Margin="14" Visibility="{Binding IsProcessorPage, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar (full-width header) -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="MicForge" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="microphone processor" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource FieldBadge}" ToolTip="Input — your microphone">
                                <TextBlock Text="IN" FontSize="11" FontWeight="SemiBold" Margin="10,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ComboBox Width="230" Margin="0,0,18,0" ItemsSource="{Binding Inputs}"
                                      SelectedItem="{Binding SelectedInput}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding NotRunning}"/>
                            <Border Style="{StaticResource FieldBadge}" ToolTip="Output — virtual mic (CABLE Input)">
                                <TextBlock Text="OUT" FontSize="11" FontWeight="SemiBold" Margin="10,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ComboBox Width="230" Margin="0,0,10,0" ItemsSource="{Binding Outputs}"
                                      SelectedItem="{Binding SelectedOutput}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding NotRunning}"/>
                            <Button Style="{StaticResource IconButton}" Content="⟳" FontSize="18"
                                    Width="36" Height="36" VerticalAlignment="Center"
                                    Command="{Binding RefreshCommand}" ToolTip="Refresh device list"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#33E5543B" CornerRadius="13" Padding="12,6" Margin="0,0,12,0"
                                    VerticalAlignment="Center" ToolTip="Your mic is muted"
                                    Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" Fill="#E5543B"/>
                                    <TextBlock Text="MUTED" FontSize="12" FontWeight="SemiBold" Foreground="#E5543B"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="13" Padding="12,6"
                                    Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding MicHealthTip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0"
                                             Fill="{Binding MicHealthColor, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding MicHealthText}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="13"
                                    Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource StartBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                                        <Setter Property="Fill" Value="#E3B23C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                                    MinWidth="128" Height="40">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource StopBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
            </Border>

            <!-- Content: chain (left) + meters (right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chain header: view switch + presets -->
                    <Grid Grid.Row="0" Margin="2,0,2,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Processing chain" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock Text="Sliders" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0" IsChecked="{Binding VisualMode}"/>
                            <TextBlock Text="Graphs" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource BypassToggle}" Content="Bypass" Margin="24,0,0,0"
                                      IsChecked="{Binding Bypassed}" ToolTip="Bypass all processing (Ctrl+B)"/>
                        <ToggleButton Style="{StaticResource MuteToggle}" Content="Mute" Margin="8,0,0,0"
                                      IsChecked="{Binding Muted}" ToolTip="Mute the output"/>
                        <Button Content="Reset order" Command="{Binding ResetOrderCommand}" Margin="16,0,0,0"
                                Padding="10,5" FontSize="12" ToolTip="Restore the default plugin order"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox Width="160" Margin="0,0,12,0" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                                  ToolTip="Load a preset (built-in or your own)"/>
                        <Button Content="Save preset" Command="{Binding SavePresetCommand}" Margin="0,0,8,0"/>
                        <Button Content="Load preset" Command="{Binding LoadPresetCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Stage cards -->
                <ScrollViewer Grid.Row="1" Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="StagesList" AllowDrop="True"
                                  ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource StageTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:MasonryPanel ColumnWidth="314"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Meters -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LEVELS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:LevelMeter Grid.Column="0" Level="{Binding InLevel}" Clipping="{Binding InClip}" Width="30" HorizontalAlignment="Center"/>
                        <ctrl:LevelMeter Grid.Column="1" Level="{Binding OutLevel}" Clipping="{Binding OutClip}" Width="30" HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IN" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="OUT" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="COMP GR" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding GrText}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="LOUDNESS" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="{Binding LufsText}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text=" LUFS" FontSize="10" VerticalAlignment="Bottom" Margin="2,0,0,2"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ================= CRAFTING PAGE ================= -->
        <ScrollViewer Grid.Column="1" Margin="14" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCraftingPage, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Craft your voice" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Stack character cards and dial their strength — they blend into the EQ, pitch and saturation live. No technical knobs required."
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Edit cards (JSON)" Command="{Binding OpenCraftFileCommand}" Margin="0,0,8,0"
                                    ToolTip="Open craftcards.json to add or tweak cards"/>
                            <Button Content="Reload" Command="{Binding ReloadCraftCommand}" Margin="0,0,8,0"
                                    ToolTip="Re-read craftcards.json"/>
                            <Button Content="Reset" Command="{Binding ResetCraftingCommand}" Margin="0,0,8,0"/>
                            <Button Content="Save as preset…" Command="{Binding SavePresetCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Live preview — tone curve + spectrum" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding PreviewSamples}"
                                          SelectedItem="{Binding SelectedPreviewSample}" DisplayMemberPath="Name"
                                          ToolTip="Preview voice"/>
                                <Button Content="Add…" Command="{Binding AddPreviewSampleCommand}" Margin="0,0,12,0"
                                        ToolTip="Import your own WAV to preview with"/>
                                <TextBlock Text="▶ Play" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PreviewSampleActive}"/>
                            </StackPanel>
                        </Grid>
                        <ctrl:EqGraph Height="180" Model="{Binding EqStage}" IsHitTestVisible="False"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Pick a voice and hit Play to hear the crafted result without talking (uses your monitor device, or the default output). Add… imports your own WAV; you can also drop clips into %AppData%\MicForge\samples. To use your own live voice, press Start on the Processor tab with Monitoring on."/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Filter" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="craftCat" Content="All" Tag="#2EC4B6"
                                 IsChecked="{Binding SelectedCraftCategory, Converter={StaticResource StrEq}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="craftCat" Content="🎚 Tone" Tag="#4FA3E3"
                                 IsChecked="{Binding SelectedCraftCategory, Converter={StaticResource StrEq}, ConverterParameter=Tone}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="craftCat" Content="✨ Polish" Tag="#E3B23C"
                                 IsChecked="{Binding SelectedCraftCategory, Converter={StaticResource StrEq}, ConverterParameter=Polish}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="craftCat" Content="😜 Fun" Tag="#E36CA0"
                                 IsChecked="{Binding SelectedCraftCategory, Converter={StaticResource StrEq}, ConverterParameter=Fun}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="craftCat" Content="📻 FX" Tag="#7FB069"
                                 IsChecked="{Binding SelectedCraftCategory, Converter={StaticResource StrEq}, ConverterParameter=FX}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding CraftView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="220" Margin="0,0,12,12" Padding="14"
                                    BorderThickness="1.5"
                                    BorderBrush="{Binding CategoryColor, Converter={StaticResource HexToBrush}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                                               Margin="0,0,0,3"/>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ToggleButton x:Name="CardInfo" Style="{StaticResource InfoToggle}" Margin="0,0,8,0"
                                                          ToolTip="What it does"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"/>
                                        </StackPanel>
                                        <Popup PlacementTarget="{Binding ElementName=CardInfo}" Placement="Bottom"
                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                               HorizontalOffset="-160" VerticalOffset="4"
                                               IsOpen="{Binding IsChecked, ElementName=CardInfo}">
                                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}"
                                                    Padding="14" MaxWidth="260">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <TextBlock Text="{Binding Blurb}" FontSize="11" TextWrapping="Wrap" Height="30"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,2"/>
                                    <ToggleButton x:Name="CardTech" Style="{StaticResource LinkToggle}"
                                                  Content="⚙ Technical peek" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Popup PlacementTarget="{Binding ElementName=CardTech}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                           VerticalOffset="4" IsOpen="{Binding IsChecked, ElementName=CardTech}">
                                        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}"
                                                Padding="12" MaxWidth="240">
                                            <StackPanel>
                                                <TextBlock Text="What it changes (at 100%)" FontWeight="SemiBold" FontSize="12"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding TechnicalPeek}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Slider Style="{StaticResource Fader}" Minimum="0" Maximum="100"
                                            Value="{Binding Intensity, Mode=TwoWay}" IsEnabled="{Binding Enabled}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= METERS PAGE ================= -->
        <ScrollViewer Grid.Column="1" Margin="14" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsMetersPage, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Meters &amp; analyzer" FontSize="22" FontWeight="Bold" Margin="2,0,0,14"/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Signal flow — processing order (dimmed = off)" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="13"
                                            Padding="10,5" Margin="0,0,6,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Accent, Converter={StaticResource HexToBrush}}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Spectrogram — output over time (newest on the right)" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ctrl:Spectrogram Height="220" Model="{Binding EqStage}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Loudness (ITU-R BS.1770 / EBU R128)" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="Reset" Command="{Binding ResetLoudnessCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="5" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Momentary" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding MomentaryLufsText}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="LUFS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Short-term" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LufsText}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="LUFS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Integrated" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding IntegratedLufsText}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="LUFS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Range (LRA)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LraText}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="LU" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="True peak" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TruePeakText}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="dBTP" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= SETTINGS PAGE ================= -->
        <ScrollViewer Grid.Column="1" Margin="14" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="640">
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="2,0,0,14"/>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Profile &amp; history" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Export your whole setup to a file to back it up or share it with a friend, or import one. Presets you save land in your presets folder and load automatically next time. Undo/redo step through recent changes (Ctrl+Z / Ctrl+Y)."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export profile…" Command="{Binding SavePresetCommand}" Margin="0,0,8,0"/>
                            <Button Content="Import profile…" Command="{Binding LoadPresetCommand}" Margin="0,0,8,0"/>
                            <Button Content="Presets folder" Command="{Binding OpenPresetsFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="↶ Undo" Command="{Binding UndoCommand}" Margin="0,0,8,0"/>
                            <Button Content="↷ Redo" Command="{Binding RedoCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Reliability &amp; diagnostics" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Follow the Windows default mic"/>
                                <TextBlock Text="Automatically switch and restart when you change your default microphone in Windows."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding FollowDefaultInput}"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Session health" FontWeight="SemiBold" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="DSP load " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DspLoadText}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="   ·   glitches " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding GlitchText}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open logs" Command="{Binding OpenLogsCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Startup &amp; tray" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows"/>
                                <TextBlock Text="Launch MicForge when you sign in (starts hidden in the tray)."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindows}"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Auto-start processing"/>
                                <TextBlock Text="Begin processing automatically as soon as the app opens."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartProcessing}"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Close to tray"/>
                                <TextBlock Text="Closing or minimizing keeps MicForge running in the system tray."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding MinimizeToTray}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Monitoring" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Also send the processed audio to a second device so you can hear yourself while it feeds the virtual mic. Use headphones to avoid feedback."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Monitor device" FontSize="12" Margin="0,0,0,5"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox Width="320" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedMonitorDevice}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Bottom"
                                      Margin="0,0,0,7" IsChecked="{Binding MonitorEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"/>
                            <Button Content="Download &amp; install" Command="{Binding InstallUpdateCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   Text="A real-time microphone processor. Route the output to a virtual audio cable and select it as your mic in any app."/>
                        <TextBlock Text="{Binding VersionText}" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="More settings coming soon." FontSize="11" Margin="4,12,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= SHORTCUTS PAGE ================= -->
        <ScrollViewer Grid.Column="1" Margin="14" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsShortcutsPage, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="660">
                <TextBlock Text="Shortcuts" FontSize="22" FontWeight="Bold" Margin="2,0,0,14"/>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Global hotkeys"/>
                                <TextBlock Text="When on, the shortcuts below work system-wide — even while another app is focused."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding GlobalHotkeysEnabled}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Display}" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                        <Button Grid.Column="2" Content="{Binding SetText}" MinWidth="98" Margin="0,0,8,0"
                                                Command="{Binding DataContext.SetHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="3" Content="Clear"
                                                Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Click Set, then press your combo (Esc cancels). A modifier (Ctrl/Alt/Shift/Win) is required, or use an F-key."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Mute overlay"/>
                                <TextBlock Text="Flash an on-screen indicator when you mute/unmute while MicForge isn't focused."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowMuteOverlay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Push-to-talk / push-to-mute"/>
                                <TextBlock Text="Hold a key to talk (muted otherwise) or to mute. Works system-wide; pick a spare key such as an F-key."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding PttEnabled}"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Hold to mute" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0" IsChecked="{Binding PttHoldToTalk}"/>
                                <TextBlock Text="Hold to talk" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Key" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Padding="10,6" Margin="12,0,8,0" HorizontalAlignment="Left" MinWidth="120">
                                <TextBlock Text="{Binding PttKeyDisplay}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <Button Grid.Column="2" Content="{Binding SetPttText}" MinWidth="110"
                                    Command="{Binding SetPttKeyCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
