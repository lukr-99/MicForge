<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MicForge</AssemblyName>
    <RootNamespace>MicForge</RootNamespace>
    <ApplicationIcon>MicForge.ico</ApplicationIcon>
    <Version>1.10.1</Version>
    <Version Condition="'$(Configuration)' == 'Debug'">1.10.1-dev</Version>
    <FileVersion>1.10.1.0</FileVersion>
    <AssemblyVersion>1.10.1.0</AssemblyVersion>
    <Product>MicForge</Product>
    <Company>lukr-99</Company>
    <Authors>lukr-99</Authors>
    <Description>Real-time microphone processor</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MicForge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!-- Shared update, tray and settings kit from GitHub Packages. -->
    <PackageReference Include="DotNetLib.Core" Version="0.4.1" />
    <PackageReference Include="DotNetLib.Tray" Version="0.4.1" />
  </ItemGroup>

  <!-- Bundle the RNNoise library (built from the official xiph source) next to the exe. -->
  <ItemGroup>
    <None Include="native\rnnoise.dll" Link="rnnoise.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Bundle the Crafting preview voice samples (CC BY-NC, see assets\VOICE-SAMPLE-LICENSE.txt). -->
  <ItemGroup>
    <None Include="assets\samples\*.wav" Link="samples\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Bundle the built-in preset snapshots (JSON) next to the exe. -->
  <ItemGroup>
    <None Include="assets\presets\*.json" Link="presets\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Bundle the built-in Crafting card defaults (JSON) next to the exe. -->
  <ItemGroup>
    <None Include="assets\craftcards.default.json" Link="craftcards.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
